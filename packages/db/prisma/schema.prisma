generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  hashedPassword String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customerMembers CustomerMember[]
  projectMembers  ProjectMember[]
  tokens          UserToken[]
}

model UserToken {
  id             String    @id @default(cuid())
  userId         String
  provider       String    // 'github' | 'azuredevops'
  scopeType      String    @default("global") // 'global' | 'customer' | 'project'
  scopeId        String?   // customerId or projectId (null if global)
  encryptedToken String    // AES-256-GCM encrypted PAT
  tokenIv        String    // initialization vector for decryption
  tokenTag       String    // auth tag for AES-GCM
  label          String    // friendly name e.g. 'My GitHub (Nobilis)'
  baseUrl        String?   // for Azure DevOps: organization URL
  expiresAt      DateTime? // optional, for display/warning
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, scopeType, scopeId])
  @@index([userId])
}

model Customer {
  id          String               @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  connections CustomerConnection[]
  projects    Project[]
  members     CustomerMember[]
}

model CustomerMember {
  id         String   @id @default(cuid())
  userId     String
  customerId String
  role       String   @default("viewer") // admin | editor | viewer
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([userId, customerId])
  @@index([customerId])
  @@index([userId])
}

model CustomerConnection {
  id         String   @id @default(cuid())
  customerId String
  type       String   // 'azure-devops' | 'github'
  name       String   // display name, e.g. "My Azure Org" or "GitHub Account"
  baseUrl    String?  // for Azure DevOps: https://dev.azure.com/{org}, for GitHub: https://api.github.com
  pat        String   // Personal Access Token
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Project {
  id              String               @id @default(cuid())
  name            String
  description     String?
  customerId      String?
  capabilities    String               @default("translation") // comma-sep: "translation,user-stories,documentation"
  // DevOps access config (for Work Items, CI, etc.)
  connectionId    String?              // pinned CustomerConnection for ADO/GitHub access
  adoProjectName  String?              // pinned ADO project (within the connection's org)
  adoAccessScope  String               @default("org") // 'org' | 'project'
  // Legacy single-repo fields (kept for backward compat)
  adoRepoName     String?
  defaultBranch   String?
  localWorkspacePath String?              // absolute path on developer's machine for VS Code navigation
  sourceLanguage  String?
  targetLanguage  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  xliffFiles        XliffFile[]
  glossaryEntries   GlossaryEntry[]
  translationMemory TranslationMemory[]
  members           ProjectMember[]
  invites           ProjectInvite[]
  repositories      ProjectRepository[]
  alHealthReviews   ALHealthReview[]

  @@index([customerId])
}

model ProjectRepository {
  id             String   @id @default(cuid())
  projectId      String
  label          String?  // friendly name e.g. "Main Repo", "Plugin Repo"
  connectionId   String   // CustomerConnection id
  adoProjectName String?  // ADO project name (for Azure DevOps)
  repoName       String   // repository name
  defaultBranch  String?  // default branch e.g. "main"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("viewer") // admin | editor | translator | viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  projectId String
  role      String    @default("viewer") // admin | editor | translator | viewer
  email     String?   // optional: restrict to specific email
  createdBy String    // userId of the creator
  expiresAt DateTime
  usedAt    DateTime?
  usedBy    String?   // userId who accepted
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([token])
}

model XliffFile {
  id               String        @id @default(cuid())
  projectId        String
  filename         String
  originalXml      String
  sourceLanguage   String
  targetLanguage   String
  uploadedAt       DateTime      @default(now())
  lastSyncAt       DateTime?     // set after every sync-from-remote
  remoteObjectId   String?       // blob SHA at last sync (ADO objectId / GitHub file SHA) — used for staleness checks
  remoteConnectionId String?     // which connection fetched this file
  remotePath       String?       // full path in repo e.g. "Translations/App.de-DE.xlf"
  remoteBranch     String?       // branch name
  remoteRepo       String?       // repo identifier: "org/project/repo" (AzDO) or "owner/repo" (GitHub)
  remotePrId       String?       // PR number/id after a PR is created
  remotePrUrl      String?       // Web URL to the PR
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations     Translation[]
}

model Translation {
  id              String    @id @default(cuid())
  xliffFileId     String
  projectId       String
  unitId          String
  source          String
  target          String    @default("")
  state           String    @default("needs-translation")
  note            String?
  developerNote   String?
  syncChangedAt             DateTime? // set when this unit was added or its source changed during a repo sync
  syncChangeType            String?   // 'added' | 'source-changed' | 'removed'
  suppressedQualityIssues   String    @default("[]") // JSON array of suppressed issue keys
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  xliffFile       XliffFile @relation(fields: [xliffFileId], references: [id], onDelete: Cascade)

  @@unique([xliffFileId, unitId])
  @@index([projectId])
  @@index([state])
  @@index([syncChangedAt])
}

model GlossaryEntry {
  id             String   @id @default(cuid())
  projectId      String
  sourceTerm     String
  targetTerm     String
  sourceLanguage String
  targetLanguage String
  description    String?
  caseSensitive  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceTerm, sourceLanguage, targetLanguage])
}

model TranslationMemory {
  id             String   @id @default(cuid())
  source         String
  target         String
  sourceLanguage String
  targetLanguage String
  projectId      String?
  usageCount     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([source, sourceLanguage, targetLanguage, projectId])
  @@index([sourceLanguage, targetLanguage])
  @@index([projectId])
}

// ─── AI Agents, Skills & MCP Connections ─────────────────────────────────────

model Agent {
  id              String              @id @default(cuid())
  name            String
  description     String?             // rich "when to use" description with trigger phrases
  customerId      String?
  projectId       String?
  modelProvider   String              @default("github-models") // 'github-models' | 'openai' | 'azure-openai' | 'ollama'
  model           String?             // specific model identifier e.g. "gpt-4o", "claude-sonnet-4-6"
  systemPrompt    String?
  triggerType     String              @default("manual") // 'manual' | 'scheduled' | 'event-driven'
  tools           String?             // JSON array of tool/capability names
  argumentHint    String?             // hint for what arguments to pass to this agent
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  skills          AgentSkill[]
  mcpConnections  AgentMCPConnection[]
  runs            AgentRun[]

  @@index([customerId])
  @@index([projectId])
}

model Skill {
  id              String        @id @default(cuid())
  name            String
  description     String?
  builtIn         Boolean       @default(false)
  type            String        @default("prompt") // 'prompt' | 'code' | 'mcp-tool'
  promptTemplate  String?       // for prompt-type skills (with {{variable}} interpolation)
  inputSchema     String?       // JSON Schema as JSON string
  outputSchema    String?       // JSON Schema as JSON string
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  agents          AgentSkill[]

  @@unique([name, builtIn])
}

model AgentSkill {
  id        String   @id @default(cuid())
  agentId   String
  skillId   String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([agentId])
  @@index([skillId])
}

model MCPConnection {
  id                  String              @id @default(cuid())
  name                String
  customerId          String?
  projectId           String?
  type                String              // 'wiki_js' | 'azure_devops_wiki' | 'github' | 'azure_devops' | 'custom'
  baseUrl             String?
  authType            String              @default("pat") // 'pat' | 'oauth' | 'api_key'
  encryptedCredential String?
  credentialIv        String?
  credentialTag       String?
  capabilities        String?             // JSON array of capability strings
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  agents              AgentMCPConnection[]

  @@index([customerId])
  @@index([projectId])
}

model AgentMCPConnection {
  id              String        @id @default(cuid())
  agentId         String
  mcpConnectionId String
  createdAt       DateTime      @default(now())
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  mcpConnection   MCPConnection @relation(fields: [mcpConnectionId], references: [id], onDelete: Cascade)

  @@unique([agentId, mcpConnectionId])
  @@index([agentId])
  @@index([mcpConnectionId])
}

model AgentRun {
  id        String   @id @default(cuid())
  agentId   String
  status    String   @default("pending") // 'pending' | 'running' | 'completed' | 'failed'
  input     String?  // JSON string of input parameters
  output    String?  // JSON string of output/results
  logs      String?  // JSON array of log entries
  error     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
}

model ALHealthReview {
  id        String   @id @default(cuid())
  projectId String
  issueKey  String   // deterministic: "{objectType}|{objectName}|{ruleId}|{line}"
  note      String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, issueKey])
  @@index([projectId])
}
