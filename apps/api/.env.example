# Use absolute path for SQLite to avoid working-directory issues
DATABASE_URL="file:C:/absolute/path/to/nexus-hive-desk/data/nexus.db"
GITHUB_TOKEN="your-github-pat-with-models-access"
AI_PROVIDER="github-models"
AI_MODEL="openai/gpt-4o-mini"
PORT=3001

# Optional: Anthropic API key — direct access to Claude models
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: OpenRouter API key — free tier available, access to Claude + 300 models
# Sign up free at https://openrouter.ai/ → Dashboard → API Keys
# When set, Claude models auto-route through OpenRouter if no ANTHROPIC_API_KEY
# OPENROUTER_API_KEY="sk-or-..."
